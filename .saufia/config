# === Runtime ===
OLLAMA_URL=http://127.0.0.1:11434
TIMEOUT=30

# === Layout ===
LAB_DIR="$CONTEXT/.lab"
THOUGHT_DIR="$CONTEXT/.state/thought"
SANDBOX_DIR="$CONTEXT/.state/sandbox"

# === Model tiers (right-size: dumbest by default) ===
DUMMY_MODEL="smollm2:135m"       # no logic, quick summary
BASIC_MODEL="qwen3:0.6b"         # digesting
MEDIUM_MODEL="qwen3-coder:1.5b"  # code
RIGHT_SIZE_MODEL="${RIGHT_SIZE_MODEL:-$DUMMY_MODEL}"
DUMMY_SIZE=64
BASIC_SIZE=256
SMALL_MODEL="$BASIC_MODEL"       # compatibility alias
MODEL="${MODEL:-$RIGHT_SIZE_MODEL}"

# === Consolidation ===
CONSOLIDATION_DIR=.digest
CONSOLIDATION_MAX_LINES=200
TOKEN_SIZE_MIN=3

# === Token budgets (EXPECTED = what we expect the answer to cost) ===
EXPECTED_TOKENS=256
MIN_TOKENS=32
MAX_TOKENS=1024
SUMMARIZE_MAX_CONCEPT=5
NOTE_MAX_CONCEPT=8

# === Prompt template defaults ===
FILETYPE="Markdown"
STYLES_SYNTAX="Headings, fenced code, tables"
FORBIDDEN=(preamble "closing remark" apologies)
KEYS="CONCEPTS"
MAX_ITEMS=5

# === CPU-first: LLM is the optional top layer ===
DOC_USE_LLM=0

# === Softcoded temps / sizes ===
FROZEN=0.0
FRESH=0.25
COLD=0.1
HAIKU_SIZE=64
GATHA_SIZE=512
SONNET=128
UNIQ=1
FROZEN_SEED=42

# === Reader ===
GLOW_PAGER="glow"
GLOW_STYLE="notty"
GLOW_WIDTH=92
MD_DIR="$DOT_ROOT"

# === Install ===
REPO_SELECT="auto"          # auto | dnf | apt | pacman | zypper | brew | go
INSTALL_ASSUME_YES=1
GLOW_PKG="glow"

# === Ollama fit ===
WORST_PREFERED=1          # 1=allow smaller fallback, 0=strict exact match
OLLAMA_FIT=1              # 1=auto-fit on load, 0=skip

# === Digest daemon ===
DIGEST_INTERVAL=60
DIGEST_BRANCH=digest

