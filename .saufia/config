# === Runtime ===
MODEL="qwen3:0.6b"
OLLAMA_URL=http://127.0.0.1:11434
SANDBOX_DIR=.sandbox
TIMEOUT=30

# === Consolidation ===
CONSOLIDATION_DIR=.consolidation
CONSOLIDATION_MAX_LINES=200
TOKEN_SIZE_MIN=3

# === Token budgets (EXPECTED = what we expect the answer to cost) ===
EXPECTED_TOKENS=256
MIN_TOKENS=32
MAX_TOKENS=1024
SUMMARIZE_MAX_CONCEPT=5
NOTE_MAX_CONCEPT=8

# === Prompt template defaults ===
FILETYPE="Markdown"
STYLES_SYNTAX="Headings, fenced code, tables"
FORBIDDEN=(preamble "closing remark" apologies)
KEYS="CONCEPTS"
MAX_ITEMS=5

# === CPU-first: LLM is the optional top layer ===
DOC_USE_LLM=0

# === Softcoded models / temps / sizes ===
SMALL_MODEL="qwen2.5-coder:0.5b"
MEDIUM_MODEL="qwen3-coder:1.5b"
FROZEN=0.0
FRESH=0.25
COLD=0.1
HAIKU_SIZE=64
GATHA_SIZE=512
SONNET=128
UNIQ=1
FROZEN_SEED=42

# === Reader ===
GLOW_PAGER="glow"
GLOW_STYLE="notty"
GLOW_WIDTH=92
MD_DIR="$DOT_ROOT"

# === Install ===
REPO_SELECT="auto"          # auto | dnf | apt | pacman | zypper | brew | go
INSTALL_ASSUME_YES=1
GLOW_PKG="glow"
