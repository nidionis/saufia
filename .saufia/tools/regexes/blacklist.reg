\bsed\b\s+-i
\bgit\b\s+(push|commit|reset|clean|checkout|switch|merge|rebase|stash\s+drop)
\b(curl|wget)\b.*(-o|-O|--output|-d|--data|-X|--request|--upload-file)
>>?\s*[^&]
\|\s*(sh|bash|zsh|dash)\b
\b(sh|bash|zsh)\s+-c\b
\bpython[0-9.]*\s+-c\b
\bperl\s+-e\b
