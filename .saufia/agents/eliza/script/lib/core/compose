compose() {
    local tmpl="$1" mirror
    mirror="$(mirror "${GRP[0]:-${GRP[1]:-}}")"
    local i v
    for i in "${!GRP[@]}"; do
        v="${GRP[$i]}"
        (( i > 0 )) && v="$(reflect "$v")"
        tmpl="${tmpl//\{$i\}/$v}"
    done
    tmpl="${tmpl//\$MIRROR/$mirror}"
    local var val
    for f in "$GRAM"/*; do
        while IFS='=' read -r var val; do
            [[ "$var" =~ ^#|^$ ]] && continue
            val="${val//\"/}"
            tmpl="${tmpl//\$$var/$val}"
        done < "$f"
    done
    echo "${tmpl^}"
}
