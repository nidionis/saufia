loop() {
    local raw norm resp
    declare -A MEM; MEM_SLOT=""
    while true; do
        printf '%s' "$PROMPT"
        IFS= read -r raw || break
        local lc="${raw,,}"; lc="${lc// /}"
        [[ "$lc" =~ $EXIT_RE ]] && { bye; break; }
        norm="$(normalize "$raw")"
        if resp="$(match "$norm")"; then
            say "$(apply "$resp")"
            [[ -n "$MEM_SLOT" ]] && MEM["$MEM_SLOT"]="${GRP[1]:-$norm}"
        else
            say "$(resort "$norm")"
        fi
    done
}
