resort() {
    local input="$1" tmpl
    local -a pool=()
    while IFS= read -r line; do
        [[ "$line" =~ ^#|^$ ]] && continue
        pool+=("$line")
    done < "$FALLBACK"
    tmpl="${pool[RANDOM%${#pool[@]}]}"
    local r; r="$(reflect "$input")"
    tmpl="${tmpl//\{0\}/$r}"
    tmpl="${tmpl//\{input\}/$input}"
    compose "$tmpl"
}
