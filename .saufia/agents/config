# Defaults inherited by every agent. Action folders narrow or widen these.
# The AI layer is right-sized: dumbest model unless an agent asks for more.
AGENT_MODEL="${AGENT_MODEL:-${RIGHT_SIZE_MODEL:-${MODEL:-qwen3:0.6b}}}"
AGENT_TEMPERATURE=0.7
AGENT_TOP_P=0.9
AGENT_TOP_K=40
AGENT_NUM_PREDICT="${AGENT_NUM_PREDICT:-${BASIC_SIZE:-256}}"
AGENT_MIROSTAT=0
AGENT_SEED=0
AGENT_THOUGHT=1

# Root ceiling: no action, no privilege.
AGENT_CAN_EDIT=0
AGENT_CAN_EXEC=0
