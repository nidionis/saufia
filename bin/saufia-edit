#!/usr/bin/env bash
# saufia-edit — guarded file writer. Grants edit via the exec action.
# Usage: saufia edit <path> [content]
# echo "hello" | saufia edit <path>
_here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
: "${CONTEXT:=${SAUFIA_CTX:-$_here/../.saufia}}"
source "$CONTEXT/lib/init.sh"
agent::load "tool/fs" || exit 1
FILE="${1:?usage: saufia edit <path> [content]}"
shift || true
if [[ $# -gt 0 ]]; then
  CONTENT="$1"
elif [[ ! -t 0 ]]; then
  CONTENT="$(cat)"
else
  echo "saufia-edit: no content" >&2
  exit 1
fi
guard::load edit || exit $?
guard::check_path "$FILE" || exit 1
guard::check "write $FILE" || exit 1
mkdir -p "$(dirname "$FILE")"
printf '%s\n' "$CONTENT" > "$FILE"
echo "edit: $FILE ($(wc -c < "$FILE") bytes)"
