#!/usr/bin/env bash
_here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
: "${CONTEXT:=${SAUFIA_CTX:-$_here/../.saufia}}"
source "$CONTEXT/lib/init.sh"
case "${1:-status}" in
  start)  shift; digest::start "${1:-}" ;;
  stop)   digest::stop ;;
  status) digest::status ;;
  run)    shift; consolidation::run "${1:-.}" ;;
  clean)  shift; consolidation::clean "${1:-.}" ;;
  merge)  digest::merge ;;
  *)      echo "usage: saufia digest <start|stop|status|run|clean|merge>" >&2 ;;
esac
